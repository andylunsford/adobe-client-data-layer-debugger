{
  "name": "acdl-debugger",
  "version": "0.4.2",
  "private": true,
  "description": "Chrome extension for debugging the Adobe Client Data Layer.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "version": "node scripts/sync-manifest-version.mjs && git add manifest.json",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.js"
  },
  "devDependencies": {
    "@adobe/adobe-client-data-layer": "3.0.1",
    "esbuild": "^0.28.2",
    "jsdom": "^24.0.0",
    "playwright": "1.56.1",
    "puppeteer-core": "25.16.0",
    "sharp": "^0.35.5",
    "vitest": "^5.0.5"
  }
}
